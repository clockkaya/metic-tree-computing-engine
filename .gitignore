# ==========================================
# 核心结构保护：忽略 Maven 骨架
# ==========================================
pom.xml
**/pom.xml
.mvn/
mvnw
mvnw.cmd

# ==========================================
# 编译产物与运行缓存
# ==========================================
target/
**/target/
*.class
*.log
*.gz
*.tmp

# ==========================================
# IDE / 编辑器私有配置 (防止泄露路径和环境)
# ==========================================
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
.factorypath
bin/
.vscode/
*.sublime-project
*.sublime-workspace

# ==========================================
# 临时文件与系统冗余
# ==========================================
tree.txt
.DS_Store
Thumbs.db
Desktop.ini

# ==========================================
# 排除敏感配置 (如 Nacos 账号、DB 密码)
# ==========================================
# 如果你的 resources 下有包含密钥的 yml，建议取消下面注释
**/src/main/resources/*.yml
**/src/main/resources/*.properties